{
  "name": "md2pdf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prestart": "npm run build:web",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "setup:web": "cd web && npm install --no-audit --no-fund",
    "postinstall": "playwright install chromium && npm run setup:web"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.1",
    "markdown-it": "^15.0.0",
    "nanoid": "^6.0.1",
    "playwright": "^1.62.1",
    "sanitize-html": "^2.17.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/sanitize-html": "^2.16.1",
    "pdfjs-dist": "^6.2.108",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
